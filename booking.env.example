# Rezerwacja online → Kalendarz Google salonu
# ------------------------------------------------------------------
# PRZYKŁAD — prawdziwe wartości ustaw WYŁĄCZNIE w panelu hostingu
# (np. Vercel → Settings → Environment Variables) albo lokalnie w .env.local.
# Pliki .env* są w .gitignore. Nigdy nie commituj klucza prywatnego.
#
# Brak zmiennych = rezerwacja online wyłączona: API zwraca 503 { error: 'disabled' },
# a strona /umow-wizyte kieruje do /kontakt i na Instagram.

# google | memory | off
#   google — Kalendarz Google (produkcja)
#   memory — kalendarz w pamięci z przykładowymi zajętościami, TYLKO dev/test;
#            przy NODE_ENV=production jest ignorowany (rezerwacja wyłączona)
#   (puste) — google, jeśli ustawione są wszystkie trzy zmienne GOOGLE_* poniżej
BOOKING_PROVIDER=google

# Adres konta usługi z Google Cloud (pole "client_email" w pliku JSON klucza).
GOOGLE_SERVICE_ACCOUNT_EMAIL=rezerwacje@nazwa-projektu.iam.gserviceaccount.com

# Klucz prywatny konta usługi (pole "private_key" z pliku JSON) — w JEDNEJ linii,
# z literalnymi \n, w cudzysłowach. Kod sam zamienia \n na nowe linie.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nWKLEJ_TUTAJ_KLUCZ\n-----END PRIVATE KEY-----\n"

# Identyfikator kalendarza salonu (dla głównego kalendarza konta Gmail = adres Gmail).
# Kalendarz musi być udostępniony adresowi konta usługi z uprawnieniem
# „Wprowadzanie zmian w wydarzeniach”.
GOOGLE_CALENDAR_ID=adres-salonu@gmail.com

# Opcjonalnie: dodatkowe domeny, z których wolno wysyłać rezerwacje (Origin),
# np. gdy serwis działa pod kilkoma adresami. Host żądania i NEXT_PUBLIC_SITE_URL
# są dozwolone automatycznie.
# BOOKING_ALLOWED_ORIGINS=https://www.as-loveliness.eu,https://as-loveliness.eu

# Zalecane: sekret do podpisów formularza i skrótów telefonu/e-maila (limit 2 wizyt na osobę).
# Losowy ciąg min. 32 znaków, np. wynik `openssl rand -hex 32`. Bez niego sekret jest
# wyliczany z GOOGLE_PRIVATE_KEY (zmiana klucza = nowy sekret).
# BOOKING_SECRET=WKLEJ_LOSOWY_CIAG

# Zalecane: Cloudflare Turnstile — niewidoczna ochrona przed robotami (dash.cloudflare.com → Turnstile).
# Działa tylko, gdy ustawione są OBIE zmienne. Klucze testowe Cloudflare (zawsze przepuszczają):
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Tylko poza Vercelem: nagłówek z prawdziwym IP klientki ustawiany przez Twoje proxy,
# np. cf-connecting-ip (Cloudflare) albo x-real-ip (nginx: proxy_set_header X-Real-IP $remote_addr).
# Bez tego limit prób na IP da się obejść podrobionym nagłówkiem. Na Vercelu zostaw puste.
# BOOKING_CLIENT_IP_HEADER=cf-connecting-ip
